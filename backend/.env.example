# =========================================================
# Backend environment configuration
# Copy to .env and fill in real values before running.
# =========================================================

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Matches docker-compose.yml (service: db, host port 5433).
DATABASE_URL=postgresql://expense:expense@localhost:5433/expense_mgmt?schema=public

# --- JWT ---
# Generate strong random values, e.g.:  openssl rand -hex 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Auth / hashing ---
BCRYPT_ROUNDS=12

# --- Receipt upload ---
# Local disk storage for this milestone (see README §Receipt Upload).
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Public base URL used to build receipt_url values returned to the client.
PUBLIC_BASE_URL=http://localhost:4000

# --- Seed (npm run seed) ---
SEED_COMPANY_NAME=Acme Inc
SEED_ADMIN_EMAIL=admin@acme.test
SEED_ADMIN_PASSWORD=Passw0rd!
SEED_MANAGER_EMAIL=manager@acme.test
SEED_MANAGER_PASSWORD=Passw0rd!
SEED_EMPLOYEE_EMAIL=employee@acme.test
SEED_EMPLOYEE_PASSWORD=Passw0rd!
