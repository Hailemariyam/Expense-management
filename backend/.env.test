# Environment for `npm test` (vitest). Uses a SEPARATE database so tests can
# TRUNCATE freely without touching dev data.
#
# Create it once:
#   docker compose exec db createdb -U expense expense_mgmt_test
#   npm run test:prepare
NODE_ENV=test
PORT=4100
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://expense:expense@localhost:5433/expense_mgmt_test?schema=public
JWT_ACCESS_SECRET=test-access-secret-do-not-use-in-prod-0000
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-in-prod-000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=8
UPLOAD_DIR=uploads/.test
MAX_UPLOAD_BYTES=5242880
PUBLIC_BASE_URL=http://localhost:4100
